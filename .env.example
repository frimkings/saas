#-------------------------------------------------------------------------------
# Copy to .env and fill in. Never commit real keys or passwords.
# After changing values in production run: php artisan config:cache
#-------------------------------------------------------------------------------

APP_NAME="Eye Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eyeclinicproject
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# Desktop/offline installs: file. Hosted (more than one server, or Laravel Cloud): a shared
# store, so cached counts, permission caches and scheduler locks agree across servers:
# CACHE_STORE=redis when a Redis/KV store is attached, otherwise CACHE_STORE=database.
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# SMS/WhatsApp for hosted clinics and billing mail are queued: production needs a
# supervised `php artisan queue:work` (a non-sync driver) and `php artisan schedule:run`.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Every clinic's email goes out through the platform's Resend account (resend.com):
# verify your sending domain there, then paste the API key. Owner emails only;
# patients are messaged by SMS.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=support@visionspacegh.com
MAIL_FROM_NAME="Nexus App"

#-------------------------------------------------------------------------------
# Multi-clinic (SaaS) mode
#-------------------------------------------------------------------------------
# true: resolve the active clinic/branch per user (hosted SaaS). false: single-clinic install.
TENANCY_CONTEXT_ENABLED=true

# Signs offline/desktop licenses issued from the platform (keep secret).
OFFLINE_LICENSE_SIGNING_KEY=

#-------------------------------------------------------------------------------
# Platform SMS gateway (EazismsPro) — every hosted clinic sends through this account
# and pays for SMS with prepaid credits bought on /platform/sms. Offline installs use
# their own credentials entered in Settings → SMS instead.
# Values come from the EazismsPro dashboard → SMS API Details. Use the base URL only
# (everything before the "?").
#-------------------------------------------------------------------------------
EAZISMS_API_URL=https://dashboard.eazismspro.com/sms/api
EAZISMS_API_KEY=
# Registered sender ID used until a clinic's own sender ID is approved (max 11 chars).
# Leave empty to use the EazismsPro account default.
EAZISMS_DEFAULT_SENDER=
# Platform admins are emailed when the provider balance drops below this, or below the
# credits clinics have prepaid, whichever is higher (checked daily at 07:00).
EAZISMS_LOW_BALANCE=1000

#-------------------------------------------------------------------------------
# Support contact shown to clinics that are locked for non-payment.
# These are defaults; platform admins can change them at /platform/support.
#-------------------------------------------------------------------------------
PLATFORM_SUPPORT_NAME=
PLATFORM_SUPPORT_PHONE=
PLATFORM_SUPPORT_WHATSAPP=
PLATFORM_SUPPORT_EMAIL=support@visionspacegh.com

#-------------------------------------------------------------------------------
# Subscription / license expiry (days)
#-------------------------------------------------------------------------------
# Every staff member sees a renewal banner this many days before expiry (admins from 30).
SUBSCRIPTION_EXPIRY_WARNING_DAYS=7
# After expiry: fully usable for GRACE_DAYS, then staff see "payment has not been made"
# and admins only the renewal page for PAYMENT_DUE_DAYS, then staff see "contact support".
SUBSCRIPTION_GRACE_DAYS=1
SUBSCRIPTION_PAYMENT_DUE_DAYS=1
# A restricted subscription is marked suspended after this many days.
SUBSCRIPTION_RESTRICTION_DAYS=7
SUBSCRIPTION_APPROVAL_EXPIRY_DAYS=7
SUBSCRIPTION_OFFBOARDING_RETENTION_DAYS=30

#-------------------------------------------------------------------------------
# Backups and legacy import (optional)
#-------------------------------------------------------------------------------
BACKUP_ARCHIVE_PASSWORD=
LEGACY_IMPORT_DB_USERNAME=
LEGACY_IMPORT_DB_PASSWORD=

#-------------------------------------------------------------------------------
# File storage (optional)
#-------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#-------------------------------------------------------------------------------
# Broadcasting (optional)
#-------------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

#-------------------------------------------------------------------------------
# Desktop build (NativePHP) — only for the offline desktop app
#-------------------------------------------------------------------------------
NATIVEPHP_APP_VERSION=
NATIVEPHP_APP_ID=
NATIVEPHP_APP_AUTHOR=
NATIVEPHP_APP_COPYRIGHT=
NATIVEPHP_APP_DESCRIPTION=
NATIVEPHP_APP_WEBSITE=
NATIVEPHP_NSIS_DELETE_APP_DATA=
NATIVEPHP_UPDATER_ENABLED=false
